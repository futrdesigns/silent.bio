# ==============================================================================
# SILENT.BIO — Environment Configuration Template
# All fields documented. App runs cleanly with defaults / fallbacks in development.
# ==============================================================================

# Supabase Database & Auth (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-client

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Upstash Redis for Sliding Window Rate Limiting (Optional - Falls back to In-Memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile Anti-bot (Optional - Gracefully bypassed in local dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Developer OAuth for Live Spotify sync
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Secret for Daily Rotating Analytics Salt
ANALYTICS_SALT_SECRET=silent_bio_secure_analytics_salt_development_secret
